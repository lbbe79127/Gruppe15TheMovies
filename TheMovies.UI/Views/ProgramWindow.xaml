<Window x:Class="TheMovies.UI.Views.ProgramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TheMovies.UI.Views"
        mc:Ignorable="d"
        Title="ProgramWindow" Height="450" Width="800">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="50*"/>
            </Grid.RowDefinitions>


            <Button x:Name="btnRegisterShowing" Content="Registrer program" Margin ="0,0,0,10" 
                    HorizontalAlignment="Left" VerticalAlignment="Center" 
                    Height="50" Width="125" 
                    Grid.Column="3" Grid.Row="4"
                    Command="{Binding RegisterCommand}" />

            <Label x:Name="lblChooseCinema" Content="Vælg Biograf" Margin ="0,10,0,0" 
                   HorizontalAlignment="Center"  VerticalAlignment="Center" 
                   Grid.Column="0" Grid.Row="0" />
            <Label x:Name="lblChooseScreen" Content="Vælg Sal&#10;(kun int)" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Grid.Column="0" Grid.Row="1" />
            <Label x:Name="lblChooseDate" Content="Vælg Dato&#10;(dd/MM/yyyy)" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Grid.Column="0" Grid.Row="2"/>
            <Label x:Name="lblChooseMovie" Content="Vælg Film" Margin ="0,10,0,0" 
          HorizontalAlignment="Center"  VerticalAlignment="Center" 
          Grid.Column="2" Grid.Row="0" />
            <Label x:Name="lblChooseStartTime" Content="Vælg Start&#10;Tid(HH:mm)" Margin ="0,10,0,0" 
          HorizontalAlignment="Center"  VerticalAlignment="Center" 
          Grid.Column="2" Grid.Row="1" />


            <ListBox x:Name="listboxCinema" Grid.Column="1" Margin ="0,0,10,10" 
                     Grid.Row="0" d:ItemsSource="{d:SampleData ItemCount=5}" 
                     ItemsSource="{Binding Cinemas}"
                     SelectedItem="{Binding SelectedCinema}"
                     DisplayMemberPath="Name"/>

            <ListBox x:Name="listboxMovies" Margin ="0,0,10,10" 
                    Grid.Row="0" Grid.Column="3" d:ItemsSource="{d:SampleData ItemCount=5}" 
                    ItemsSource="{Binding Movies}"
                    SelectedItem="{Binding SelectedMovie}"
                    DisplayMemberPath="Title"/>

            <TextBox Text="{Binding SelectedScreen}"
             HorizontalAlignment="Left" VerticalAlignment="Center" 
             Grid.Column="1" Grid.Row="1" Width="100"
             />

            <!---  
            <ListBox x:Name="listboxScreen" Grid.Column="1" Margin ="0,0,10,10" 
                     Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}"/>
            -->
            <TextBox Text="{Binding SelectedStartTime}"
                        HorizontalAlignment="Left" VerticalAlignment="Center" 
                        Grid.Column="3" Grid.Row="1" Width="100"
                        />

            <!-- A DatePicker that has March 23, 2009 selected and 
           displays the Long date format. 
            <DatePicker  SelectedDateFormat="Long" Text="{Binding SelectedDate}"
                        DisplayDateStart="1/01/26" DisplayDateEnd="12/31/26" 
                        HorizontalAlignment="Left" VerticalAlignment="Center" 
                        Grid.Column="1" Grid.Row="2" 
                        FirstDayOfWeek="Monday"/>
            -->
            <TextBox Text="{Binding SelectedDate}"
            HorizontalAlignment="Left" VerticalAlignment="Center" 
            Grid.Column="1" Grid.Row="2" Width="100"
            />
        </Grid>
    </Grid>
</Window>
